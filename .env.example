# =============================================================================
# VARIABLES DE ENTORNO DE EJEMPLO (.env.example)
# Control Predictivo de Neumáticos CAEX · Equipo 3 USACH
# Copia este archivo como .env y completa con tus credenciales reales en Supabase
# =============================================================================

# Configuración de Supabase (PostgreSQL Cloud)
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=tu_clave_anon_publica
# El prototipo estático lee estos mismos valores desde src/config.js (no usa build de Vite).
# Clave privada: solo para scripts de administración locales. NUNCA en src/ ni en Vercel.
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key-privada

# Configuración de Backend API (FastAPI)
PORT=8000
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,https://*.vercel.app

# Parámetros del Modelo Predictivo de Desgaste (v1.3)
UMBRAL_RETIRO_MM=20.0
UMBRAL_ZONA_ROJA_H=200
UMBRAL_ZONA_AMARILLA_H=500

# Conexión Directa a Base de Datos (Opcional para scripts de migración backend)
DATABASE_URL=postgresql://postgres:tu_contraseña_secreta@db.tu-proyecto.supabase.co:5432/postgres

